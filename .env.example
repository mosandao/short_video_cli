# LLM 润色配置（transcribe --polish 用）。复制为 .env 并填入真实值；环境变量优先级更高
# 环境变量: GALAXY_LLM_API_KEY / GALAXY_LLM_MODEL / GALAXY_LLM_BASE_URL

api_key=your-api-key
model=glm-5.3-flash
base_url=https://open.bigmodel.cn/api/coding/paas/v4

# ---- 其他可用的环境变量（也可直接 export，无需写进本文件）----
# 本地 ASR 转录模型路径（默认 ~/.omlx/models/Qwen3-ASR-0.6B-8bit）
# GALAXY_WHISPER_MODEL=/Users/yiyi/.omlx/models/Qwen3-ASR-0.6B-8bit
# 本地 ASR 服务地址（默认 http://127.0.0.1:8300）
# GALAXY_ASR_API=http://127.0.0.1:8300
# --browser 模式 Edge 远程调试地址（默认 http://127.0.0.1:9222）
# GALAXY_CHROME_DEBUG_URL=http://127.0.0.1:9222
